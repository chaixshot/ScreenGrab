<UserControl
    x:Class="ScreenGrab.UcCharacter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Border
        MinWidth="24"
        Margin="2,0"
        Padding="7,3,7,3"
        Background="#38383A"
        CornerRadius="4">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#4DFFFFFF" />
                <GradientStop Offset="1" Color="#10000000" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="4"
                Direction="270"
                Opacity="0.25"
                ShadowDepth="1"
                Color="#000000" />
        </Border.Effect>
        <Border.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F3F3F3" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, sans-serif" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Border.Resources>
        <TextBlock
            x:Name="CharacterText"
            Text="{Binding DisplayChar, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </Border>
</UserControl>